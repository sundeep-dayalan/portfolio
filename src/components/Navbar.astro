---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'HOME', href: '/', id: 'nav-home' },
  { label: 'ABOUT', href: '/#about', id: 'nav-about' },
  { label: 'SKILLS', href: '/#skills', id: 'nav-skills' },
  { label: 'EXPERIENCE', href: '/#experience', id: 'nav-experience' },
  { label: 'PROJECTS', href: '/#projects', id: 'nav-projects' },
  { label: 'RESEARCH', href: '/#research', id: 'nav-research' },
  { label: 'CONTACT', href: '/#contact', id: 'nav-contact' },
];
---

<header class="nav-header" id="main-nav">
  <div class="nav-container">
    <a href="/" class="nav-logo" id="nav-logo" aria-label="Sundeep Dayalan Home">
      <span class="logo-text">SD</span><span class="logo-accent">.</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
          id={item.id}
        >
          <span class="nav-link-index">0{i + 1}</span>
          <span class="nav-link-label">{item.label}</span>
        </a>
      ))}
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="toggle-line"></span>
      <span class="toggle-line"></span>
      <span class="toggle-line"></span>
    </button>
  </div>
</header>

<!-- Mobile overlay nav -->
<div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true">
  <nav class="mobile-nav-links" aria-label="Mobile navigation">
    {navItems.map((item, i) => (
      <a
        href={item.href}
        class="mobile-nav-link"
        id={`mobile-${item.id}`}
      >
        <span class="mobile-nav-index">0{i + 1}</span>
        <span class="mobile-nav-label">{item.label}</span>
      </a>
    ))}
  </nav>
  <div class="mobile-nav-footer">
    <span>SUNDEEP DAYALAN — BELLEVUE, WA</span>
  </div>
</div>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-normal), background var(--transition-normal);
  }

  .nav-header.scrolled {
    background: rgba(0, 0, 0, 0.92);
    border-bottom-color: var(--color-border);
  }

  .nav-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-bright);
    text-decoration: none;
  }

  .nav-logo:hover { color: var(--color-text-bright); }

  .logo-accent {
    color: var(--color-primary);
    text-shadow: 0 0 16px rgba(0, 240, 255, 0.5);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-text-dim);
    text-decoration: none;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    position: relative;
    transition: color var(--transition-fast);
  }

  /* Sliding underline */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out-expo);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text-bright);
  }

  .nav-link-index {
    font-size: 0.52rem;
    color: var(--color-primary);
    opacity: 0.7;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: var(--space-sm);
    background: none;
    border: 1px solid var(--color-border);
    cursor: pointer;
    z-index: 1001;
    min-width: 44px;
    min-height: 44px;
    transition: border-color var(--transition-fast);
  }

  .nav-toggle:hover { border-color: var(--color-border-bright); }

  .toggle-line {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--color-text-bright);
    transition: all var(--transition-normal);
  }

  .nav-toggle.active .toggle-line:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  .nav-toggle.active .toggle-line:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle.active .toggle-line:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* Mobile Overlay */
  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0, 0, 0, 0.98);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 0 var(--space-xl);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
  }

  .mobile-nav-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-lg) 0;
    max-height: 80vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
  }

  .mobile-nav-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 8vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text-bright);
    text-decoration: none;
    transition: color var(--transition-fast), transform 0.35s var(--ease-out-expo);
    min-height: 44px;
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
    width: 100%;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-primary);
    transform: translateX(10px);
  }

  .mobile-nav-index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--color-primary);
  }

  .mobile-nav-footer {
    position: absolute;
    bottom: var(--space-xl);
    left: var(--space-xl);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    color: var(--color-text-dim);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .nav-container {
      padding: 0 var(--space-md);
    }
  }

  @media (max-height: 600px) and (orientation: landscape) {
    .mobile-nav-links {
      gap: var(--space-sm);
    }
    .mobile-nav-link {
      font-size: 1.1rem;
      min-height: 36px;
    }
  }
</style>

<script>
  /* Re-initialized on every client-side navigation (View Transitions) */
  let navAC: AbortController | undefined;
  let navObserver: IntersectionObserver | undefined;

  function initNav() {
  navAC?.abort();
  navAC = new AbortController();
  const { signal } = navAC;
  navObserver?.disconnect();

  // Scroll effect
  const header = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true, signal });

  // Mobile toggle
  const toggle = document.getElementById('nav-toggle');
  const overlay = document.getElementById('mobile-nav-overlay');

  toggle?.addEventListener('click', () => {
    toggle.classList.toggle('active');
    overlay?.classList.toggle('active');
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!expanded).toString());
    overlay?.setAttribute('aria-hidden', expanded.toString());
    document.body.style.overflow = expanded ? '' : 'hidden';
  });

  // Close mobile nav on link click
  overlay?.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      toggle?.classList.remove('active');
      overlay?.classList.remove('active');
      toggle?.setAttribute('aria-expanded', 'false');
      overlay?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });

  // ======== Scroll Spy ========
  const sectionIds = ['hero', 'about', 'skills', 'experience', 'projects', 'education', 'research', 'certifications', 'contact'];
  const navLinkMap: Record<string, { desktop: Element | null; mobile: Element | null }> = {};

  sectionIds.forEach(id => {
    const navId = id === 'hero' ? 'home' : id;
    navLinkMap[id] = {
      desktop: document.getElementById(`nav-${navId}`),
      mobile: document.getElementById(`mobile-nav-${navId}`),
    };
  });

  let currentActive = '';
  let isAtBottom = false;

  function setActiveLink(sectionId: string, force = false) {
    if (!force && currentActive === sectionId) return;
    if (!force && isAtBottom) return;

    document.querySelectorAll('.nav-link, .mobile-nav-link').forEach(link => {
      link.classList.remove('active');
    });

    const entry = navLinkMap[sectionId];
    if (entry) {
      entry.desktop?.classList.add('active');
      entry.mobile?.classList.add('active');
    }

    currentActive = sectionId;
  }

  const observerOptions: IntersectionObserverInit = {
    root: null,
    rootMargin: '-10% 0px -55% 0px',
    threshold: 0,
  };

  const visibleSections = new Set<string>();

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const id = entry.target.id;
      if (entry.isIntersecting) {
        visibleSections.add(id);
      } else {
        visibleSections.delete(id);
      }
    });

    if (isAtBottom) return;

    for (const id of sectionIds) {
      if (visibleSections.has(id)) {
        setActiveLink(id);
        return;
      }
    }
  }, observerOptions);

  sectionIds.forEach(id => {
    const section = document.getElementById(id);
    if (section) {
      sectionObserver.observe(section);
    }
  });
  navObserver = sectionObserver;

  if (window.scrollY < 100) {
    setActiveLink('hero');
  }

  window.addEventListener('scroll', () => {
    const scrollBottom = window.innerHeight + window.scrollY;
    const pageHeight = document.documentElement.scrollHeight;
    const nearBottom = pageHeight - scrollBottom < 200;

    if (nearBottom && !isAtBottom) {
      isAtBottom = true;
      setActiveLink('contact', true);
    } else if (!nearBottom && isAtBottom) {
      isAtBottom = false;
      for (const id of sectionIds) {
        if (visibleSections.has(id)) {
          setActiveLink(id, true);
          return;
        }
      }
    }
  }, { passive: true, signal });
  }

  document.addEventListener('astro:page-load', initNav);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initNav();
  } else {
    document.addEventListener('DOMContentLoaded', initNav);
  }
</script>
