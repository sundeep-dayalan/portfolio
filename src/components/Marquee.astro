---
/**
 * Marquee — infinite kinetic text band, reactive to scroll velocity.
 * JS-driven position (not CSS animation) so speed and skew respond
 * to how fast the user scrolls. Outline type + accent separators.
 */
interface Props {
  items: string[];
  /** base px/frame drift */
  speed?: number;
  /** drift right instead of left */
  reverse?: boolean;
}
const { items, speed = 0.6, reverse = false } = Astro.props;
---

<div class="mq" data-marquee data-speed={speed} data-reverse={reverse ? '1' : '0'} aria-hidden="true">
  <div class="mq-track">
    {[...items, ...items].map((item) => (
      <span class="mq-item">
        {item}
        <span class="mq-sep">/</span>
      </span>
    ))}
  </div>
</div>

<style>
  .mq {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.1rem 0;
    background: #000;
    z-index: 1;
    user-select: none;
  }

  .mq-track {
    display: flex;
    align-items: baseline;
    gap: 2.5rem;
    width: max-content;
    will-change: transform;
  }

  .mq-item {
    display: inline-flex;
    align-items: baseline;
    gap: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text-dim);
    transition: -webkit-text-stroke-color 0.4s var(--ease-out-expo);
  }

  .mq:hover .mq-item {
    -webkit-text-stroke-color: var(--color-text-bright);
  }

  .mq-sep {
    color: var(--color-primary);
    -webkit-text-stroke: 0;
    font-weight: 400;
  }

  @media (prefers-reduced-motion: reduce) {
    .mq-track { transform: none !important; }
  }
</style>

<script>
  /* Re-initialized on every client-side navigation (View Transitions) */
  let mqAC: AbortController | undefined;
  let mqRaf = 0;

  function initMq() {
    mqAC?.abort();
    cancelAnimationFrame(mqRaf);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const marquees = Array.from(document.querySelectorAll<HTMLElement>('[data-marquee]'));
    if (!marquees.length) return;
    mqAC = new AbortController();
    const { signal } = mqAC;

    const state = marquees.map((el) => {
      const track = el.querySelector<HTMLElement>('.mq-track')!;
      return {
        el,
        track,
        x: 0,
        half: 0,
        base: parseFloat(el.dataset.speed || '0.6') * (el.dataset.reverse === '1' ? -1 : 1),
      };
    });

    const measure = () => {
      for (const m of state) m.half = m.track.scrollWidth / 2;
    };
    measure();
    window.addEventListener('resize', measure, { passive: true, signal });

    let lastY = window.scrollY;
    let velocity = 0;

    function tick() {
      const y = window.scrollY;
      /* exponential decay toward current scroll velocity */
      velocity += ((y - lastY) - velocity) * 0.12;
      lastY = y;

      const boost = Math.max(-18, Math.min(18, velocity * 0.45));
      const skew = Math.max(-5, Math.min(5, velocity * 0.06));

      for (const m of state) {
        if (!m.half) continue;
        m.x -= m.base + boost * (m.base < 0 ? -1 : 1);
        /* wrap seamlessly in both directions */
        m.x = ((m.x % m.half) + m.half) % m.half;
        m.track.style.transform = `translate3d(${-m.x}px, 0, 0) skewX(${-skew}deg)`;
      }
      mqRaf = requestAnimationFrame(tick);
    }
    mqRaf = requestAnimationFrame(tick);
  }

  document.addEventListener('astro:page-load', initMq);
</script>
