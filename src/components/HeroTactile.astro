---
/**
 * HeroTactile — Tactile Minimalism / High-Contrast Dark Mode hero.
 * True black OLED background · exposed grid · film grain · kinetic orb ·
 * staggered mask text reveal · magnetic CTAs · custom difference cursor.
 */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';

interface Props {
  projectsCount?: number;
}
const { projectsCount = 9 } = Astro.props;

const line1 = 'SUNDEEP'.split('');
const line2 = 'DAYALAN'.split('');

const stats = [
  { value: '5+', label: 'YRS EXPERIENCE' },
  { value: '5M+', label: 'USERS SERVED' },
  { value: '99.99%', label: 'UPTIME' },
  { value: `${projectsCount}+`, label: 'PROJECTS' },
];
---

<section class="ht-hero" id="hero" aria-label="Introduction">
  <!-- Exposed structural grid -->
  <div class="ht-grid" aria-hidden="true"></div>

  <!-- Kinetic accent orb -->
  <div class="ht-orb" id="ht-orb" aria-hidden="true"></div>

  <div class="ht-container">
    <!-- Meta row -->
    <div class="ht-meta ht-fade" style="--d: 1.1s">
      <span class="ht-meta-item">SDE II @ AMAZON WEB SERVICES</span>
      <span class="ht-meta-item ht-meta-mid">DISTRIBUTED SYSTEMS · AGENTIC AI · FINTECH</span>
      <span class="ht-meta-item">47.6101°N — BELLEVUE, WA</span>
    </div>

    <!-- Headline -->
    <h1 class="ht-title">
      <span class="ht-line" aria-label="Sundeep">
        {line1.map((ch, i) => (
          <span class="ht-mask"><span class="ht-ch" style={`--i: ${i}`}>{ch}</span></span>
        ))}
      </span>
      <span class="ht-line ht-line-outline" aria-label="Dayalan">
        {line2.map((ch, i) => (
          <span class="ht-mask"><span class="ht-ch" style={`--i: ${i + line1.length}`}>{ch}</span></span>
        ))}<span class="ht-mask"><span class="ht-ch ht-ch-accent" style={`--i: ${line1.length + line2.length}`}>.</span></span>
      </span>
    </h1>

    <!-- Tagline + CTA row -->
    <div class="ht-lower">
      <p class="ht-tagline ht-fade" style="--d: 1.25s">
        Architecting high-throughput distributed systems, agentic AI
        infrastructure and real-time fintech platforms — 5M+ users,
        sub-200ms p99, 99.99% uptime.
      </p>

      <div class="ht-actions ht-fade" style="--d: 1.4s">
        <a href="#contact" class="ht-cta ht-magnetic" data-cursor="hover">
          <span class="ht-cta-label">INITIALIZE CONTACT</span>
          <span class="ht-cta-arrow" aria-hidden="true">→</span>
        </a>
        <div class="ht-socials">
          <a href="https://github.com/sundeep-dayalan" target="_blank" rel="noopener noreferrer" class="ht-social ht-magnetic" data-cursor="hover">GITHUB</a>
          <a href="https://www.linkedin.com/in/sundeep-dayalan" target="_blank" rel="noopener noreferrer" class="ht-social ht-magnetic" data-cursor="hover">LINKEDIN</a>
        </div>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="ht-stats ht-fade" style="--d: 1.55s">
      {stats.map((s) => (
        <div class="ht-stat">
          <span class="ht-stat-value">{s.value}</span>
          <span class="ht-stat-label">{s.label}</span>
        </div>
      ))}
      <div class="ht-scroll" aria-hidden="true">
        <span>SCROLL</span>
        <span class="ht-scroll-line"></span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Local design tokens ─── */
  .ht-hero {
    --x-bg: #000000;
    --x-surface: #0a0a0a;
    --x-border: #222222;
    --x-border-hi: #333333;
    --x-text: #f0f0f0;
    --x-muted: #888888;
    --x-accent: #00f0ff;
    --x-display: 'Space Grotesk Variable', 'Space Grotesk', system-ui, sans-serif;
    --x-mono: 'JetBrains Mono Variable', 'JetBrains Mono', 'SFMono-Regular', monospace;
    --x-ease: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: var(--x-bg);
    overflow: hidden;
    padding: 96px 0 0;
    border-bottom: 1px solid var(--x-border);
    z-index: 1;
  }

  /* ─── Exposed grid: faint vertical lines every quarter ─── */
  .ht-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgba(240, 240, 240, 0.05) 1px, transparent 1px);
    background-size: 25% 100%;
    background-position: 0 0;
    pointer-events: none;
    z-index: 0;
  }

  /* ─── Kinetic gradient orb ─── */
  .ht-orb {
    position: absolute;
    width: 640px;
    height: 640px;
    top: -180px;
    right: -160px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 35%,
      rgba(0, 240, 255, 0.16) 0%,
      rgba(0, 240, 255, 0.05) 42%,
      transparent 70%
    );
    filter: blur(70px);
    pointer-events: none;
    will-change: transform;
    animation: ht-drift 22s ease-in-out infinite alternate;
    z-index: 0;
  }

  @keyframes ht-drift {
    0%   { transform: translate3d(0, 0, 0) scale(1); }
    50%  { transform: translate3d(-9%, 14%, 0) scale(1.12); }
    100% { transform: translate3d(4%, -6%, 0) scale(0.95); }
  }

  .ht-container {
    position: relative;
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    padding: 0 2rem;
    z-index: 1;
  }

  /* ─── Meta row ─── */
  .ht-meta {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
    border-bottom: 1px solid var(--x-border);
    font-family: var(--x-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: var(--x-muted);
  }

  .ht-meta-item { white-space: nowrap; }

  /* ─── Headline: viewport-scaled, mask-revealed ─── */
  .ht-title {
    font-family: var(--x-display);
    font-weight: 700;
    font-size: clamp(3.4rem, 12.5vw, 10.5rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: var(--x-text);
    margin: 0 0 clamp(2rem, 5vh, 3.5rem);
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
  }

  .ht-line { display: block; white-space: nowrap; }

  .ht-line-outline .ht-ch {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--x-text);
    transition: color 0.35s var(--x-ease), -webkit-text-stroke-color 0.35s var(--x-ease);
  }

  .ht-line-outline:hover .ht-ch {
    color: var(--x-accent);
    -webkit-text-stroke-color: var(--x-accent);
  }

  .ht-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .ht-ch {
    display: inline-block;
    transform: translateY(115%);
    animation: ht-reveal 0.9s var(--x-ease) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.038s);
    will-change: transform;
  }

  .ht-ch-accent {
    color: var(--x-accent);
    -webkit-text-stroke: 0 !important;
    text-shadow: 0 0 32px rgba(0, 240, 255, 0.55);
  }

  @keyframes ht-reveal {
    to { transform: translateY(0); }
  }

  /* ─── Fade-up entrances ─── */
  .ht-fade {
    opacity: 0;
    transform: translateY(18px);
    animation: ht-fade-up 0.8s var(--x-ease) forwards;
    animation-delay: var(--d, 1s);
  }

  @keyframes ht-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ─── Lower row: tagline + actions ─── */
  .ht-lower {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .ht-tagline {
    font-family: var(--x-mono);
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    line-height: 1.85;
    color: var(--x-muted);
    max-width: 52ch;
    margin: 0;
  }

  .ht-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .ht-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.05rem 1.8rem;
    font-family: var(--x-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--x-text);
    background: var(--x-surface);
    border: 1px solid var(--x-border-hi);
    text-decoration: none;
    transition: border-color 0.3s var(--x-ease), color 0.3s var(--x-ease),
      box-shadow 0.3s var(--x-ease);
    will-change: transform;
  }

  .ht-cta:hover {
    color: var(--x-accent);
    border-color: var(--x-accent);
    box-shadow: 0 0 24px rgba(0, 240, 255, 0.18), inset 0 0 12px rgba(0, 240, 255, 0.06);
  }

  .ht-cta-arrow { transition: transform 0.3s var(--x-ease); }
  .ht-cta:hover .ht-cta-arrow { transform: translateX(5px); }

  .ht-socials { display: flex; gap: 1.5rem; }

  .ht-social {
    font-family: var(--x-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--x-muted);
    text-decoration: none;
    padding: 0.5rem 0.15rem;
    border-bottom: 1px solid transparent;
    transition: color 0.25s var(--x-ease), border-color 0.25s var(--x-ease);
    will-change: transform;
  }

  .ht-social:hover {
    color: var(--x-accent);
    border-bottom-color: var(--x-accent);
  }

  /* ─── Stats strip ─── */
  .ht-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr) auto;
    border-top: 1px solid var(--x-border);
    border-left: 1px solid var(--x-border);
  }

  .ht-stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem 1.5rem;
    border-right: 1px solid var(--x-border);
    transition: background 0.3s var(--x-ease);
  }

  .ht-stat:hover { background: var(--x-surface); }

  .ht-stat-value {
    font-family: var(--x-display);
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--x-text);
  }

  .ht-stat:hover .ht-stat-value {
    color: var(--x-accent);
    text-shadow: 0 0 24px rgba(0, 240, 255, 0.35);
  }

  .ht-stat-label {
    font-family: var(--x-mono);
    font-size: 0.58rem;
    letter-spacing: 0.24em;
    color: var(--x-muted);
  }

  .ht-scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0 1.4rem;
    border-right: 1px solid var(--x-border);
    font-family: var(--x-mono);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    color: var(--x-muted);
    writing-mode: vertical-rl;
  }

  .ht-scroll-line {
    width: 1px;
    height: 26px;
    background: linear-gradient(180deg, var(--x-accent), transparent);
    animation: ht-scroll-pulse 2.2s var(--x-ease) infinite;
  }

  @keyframes ht-scroll-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; transform-origin: top; }
    50% { transform: scaleY(1); opacity: 1; transform-origin: top; }
  }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .ht-lower { grid-template-columns: 1fr; align-items: start; }
    .ht-actions { justify-content: flex-start; }
    .ht-meta-mid { display: none; }
    .ht-stats { grid-template-columns: repeat(2, 1fr); }
    .ht-stat { border-bottom: 1px solid var(--x-border); }
    .ht-scroll { display: none; }
  }

  @media (max-width: 520px) {
    .ht-container { padding: 0 1.25rem; }
    .ht-meta { flex-direction: column; gap: 0.5rem; }
    .ht-title { font-size: clamp(3rem, 16.5vw, 4.6rem); }
  }

  /* ─── Reduced motion: everything lands instantly ─── */
  @media (prefers-reduced-motion: reduce) {
    .ht-ch { transform: none; animation: none; }
    .ht-fade { opacity: 1; transform: none; animation: none; }
    .ht-orb { animation: none; }
    .ht-scroll-line { animation: none; }
  }
</style>

<script>
  /* Re-initialized on every client-side navigation (View Transitions) */
  let heroAC: AbortController | undefined;
  let heroRaf = 0;

  function initHero() {
    heroAC?.abort();
    cancelAnimationFrame(heroRaf);
    if (!document.querySelector('.ht-hero')) return;
    heroAC = new AbortController();
    const { signal } = heroAC;

    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!finePointer || reducedMotion) return;

    /* ── Kinetic orb: slow mouse-reactive drift (cursor + magnetics live in BaseLayout) ── */
    const orb = document.getElementById('ht-orb');
    const heroContainer = document.querySelector<HTMLElement>('.ht-container');
    let ox = 0, oy = 0;
    let tox = 0, toy = 0;

    window.addEventListener('mousemove', (e) => {
      tox = (e.clientX / window.innerWidth - 0.5) * 60;
      toy = (e.clientY / window.innerHeight - 0.5) * 40;
    }, { passive: true, signal });

    const lerp = (a: number, b: number, n: number) => a + (b - a) * n;

    function tick() {
      ox = lerp(ox, tox, 0.04);
      oy = lerp(oy, toy, 0.04);
      if (orb) orb.style.setProperty('translate', `${ox}px ${oy}px`);

      /* Depth parallax: hero content sinks + fades as you scroll past */
      if (heroContainer) {
        const sy = window.scrollY;
        const vh = window.innerHeight;
        if (sy < vh * 1.2) {
          heroContainer.style.transform = `translateY(${(sy * 0.28).toFixed(1)}px)`;
          heroContainer.style.opacity = String(Math.max(0, 1 - sy / (vh * 0.85)));
        }
      }
      heroRaf = requestAnimationFrame(tick);
    }
    heroRaf = requestAnimationFrame(tick);

    /* ── Stat count-up: numbers roll in after the reveal ── */
    const stats = document.querySelectorAll<HTMLElement>('.ht-stat-value');
    stats.forEach((el) => {
      const raw = el.textContent || '';
      const match = raw.match(/^([\d.]+)(.*)$/);
      if (!match) return;
      const target = parseFloat(match[1]);
      const suffix = match[2];
      const decimals = (match[1].split('.')[1] || '').length;
      const D = 1400;
      const t0 = performance.now() + 700;
      const step = (now: number) => {
        const t = Math.min(Math.max((now - t0) / D, 0), 1);
        const eased = 1 - Math.pow(1 - t, 4);
        el.textContent = (target * eased).toFixed(decimals) + suffix;
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = raw;
      };
      requestAnimationFrame(step);
    });
  }

  document.addEventListener('astro:page-load', initHero);
</script>
