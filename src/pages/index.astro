---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import HeroTactile from "../components/HeroTactile.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import Marquee from "../components/Marquee.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const rawImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*",
  { eager: true },
);
function assetImg(filename: string): ImageMetadata {
  const clean = filename.startsWith("/") ? filename.slice(1) : filename;
  const mod = rawImages[`/src/assets/images/${clean}`];
  if (!mod) throw new Error(`Image not found: ${clean}`);
  return mod.default;
}

/* Cursor-following preview images for the project index (empty = themed fallback tile) */
const projectPreviews: Record<string, string> = {
  "/projects/multi-agent-finance": "",
  "/projects/mindkeep": "project-mindkeep.jpg",
  "/projects/sky-bms": "project-skybms.png",
  "/projects/web-hunter": "project-web-hunter.png",
  "/projects/robotic-arm": "project-robotic-arm.png",
  "/projects/toolkit-for-whatsapp": "project-whatsapp.png",
  "/projects/smart-traffic-management": "project-traffic.png",
  "/projects/smart-home": "project-smart-home.png",
};

const title =
  "Sundeep Dayalan | Software Development Engineer II @ AWS — Distributed Systems · AI Infrastructure";
const description =
  "Portfolio of Sundeep Dayalan — Software Development Engineer II at Amazon Web Services, architecting fault-tolerant distributed systems, LLM orchestration, and real-time cloud platforms at massive scale. Python, Java/Spring Boot, React/TypeScript. Published researcher & patent holder. Bellevue, WA.";

const skills = [
  {
    name: "Backend",
    desc: "Python, Django, DRF, Java, Spring Boot, Node.js, C++, FastAPI, GraphQL, REST APIs, gRPC",
    tags: ["Python", "Django", "Java", "Spring Boot", "FastAPI", "gRPC"],
  },
  {
    name: "Frontend",
    desc: "React, TypeScript, JavaScript, MUI, Component Libraries, Dynamic Data Visualizations, Responsive UI",
    tags: ["React", "TypeScript", "MUI", "JavaScript"],
  },
  {
    name: "Data Engineering",
    desc: "PySpark, Databricks, Delta Lake, Apache Kafka, Spark, Airflow, GCP Dataflow, ETL/ELT, 1B+ event pipelines",
    tags: ["Kafka", "PySpark", "Databricks", "Airflow"],
  },
  {
    name: "AI/ML & LLM",
    desc: "LLM Orchestration, LangChain, LangGraph, Multi-Agent Systems, RAG, Agentic Workflows, Vector Search, TensorFlow",
    tags: ["LangChain", "RAG", "LangGraph", "TensorFlow"],
  },
  {
    name: "Cloud & Infra",
    desc: "AWS (CDK, S3, Lambda), GCP (BigQuery, Dataflow), Azure, Terraform, Kubernetes, Docker, Jenkins, CI/CD, GitOps",
    tags: ["AWS", "GCP", "Azure", "Terraform", "K8s"],
  },
  {
    name: "Databases",
    desc: "PostgreSQL, BigQuery, T-SQL, Redis (sharding, replication), Azure Cosmos DB, SQL Query Optimization",
    tags: ["PostgreSQL", "Redis", "BigQuery", "Cosmos DB"],
  },
  {
    name: "Observability & SRE",
    desc: "OpenTelemetry, Distributed Tracing, Prometheus, Grafana, SLO/SLA Design, Dynatrace, Splunk, p99 Tuning",
    tags: ["OpenTelemetry", "Prometheus", "Grafana", "Splunk"],
  },
  {
    name: "Security & Compliance",
    desc: "RBAC, PII Handling, Zero-Trust, SOC2/GDPR, Azure AD, OAuth 2.0, JWT, ACH/NACHA, WCAG 2.1 Accessibility",
    tags: ["RBAC", "OAuth 2.0", "Zero-Trust", "WCAG"],
  },
];

const experience = [
  {
    company: "Amazon Web Services",
    role: "SDE II",
    period: "Aug 2026 — Present",
    location: "Redmond, WA, USA",
    summary:
      "Building the telemetry infrastructure behind Amazon Aurora and RDS — systems that collect, ingest, and route database telemetry across millions of instances, feeding a fleet-wide data lake and AI-driven engines that detect performance anomalies, diagnose root causes, and deliver tuning recommendations to customers at massive scale.",
  },
  {
    company: "Accenture",
    note: "Contract",
    role: "Full Stack Engineer",
    period: "May 2024 — Jul 2026",
    location: "USA",
    summary:
      "Architected a production-grade banking platform end to end — Python/Java Spring Boot APIs, React/TypeScript frontend, and Kafka streaming pipelines serving 5M+ users at sub-200ms p99. Delivered 99.99% uptime with sharded Redis clusters, OpenTelemetry tracing across 15+ microservices, and Terraform/Jenkins GitOps automation, while driving zero-trust RBAC and org-wide ADRs across 4 squads.",
  },
  {
    company: "Accenture",
    role: "Software Engineer",
    period: "Jun 2019 — Aug 2022",
    location: "Chennai, India",
    summary:
      "Designed fault-tolerant REST & GraphQL APIs sustaining 5M+ TPS at sub-100ms SLAs and built PySpark ETL/ELT pipelines on Databricks with Delta Lake — cutting large-scale processing time 45% through Python and BigQuery optimization while mentoring junior engineers on SRE practices.",
  },
];

const projects = [
  {
    name: "Sentient Trader — Autonomous AI Trading Agent",
    tech: "Python, LangGraph, Groq LLaMA 3.1, Alpaca API, Redis Streams, Next.js",
    period: "2026",
    link: "/projects/sentient-trader",
    bullets: [
      "Built an autonomous AI trading agent that ingests live market news, reasons across multiple signals, and executes paper trades with no manual intervention.",
      "Integrated LangGraph orchestration with Groq-hosted LLaMA 3.1 and Alpaca trading APIs for end-to-end decisioning and execution.",
      "Shipped production live demo with real-time streaming architecture and monitoring-focused workflow for safe iteration.",
    ],
  },
  {
    name: "Multi-Agent Agentic AI Financial Platform",
    tech: "Python, Plaid API, LangChain, LangGraph, LLMs, RAG",
    period: "Sep 2025 — Present",
    link: "/projects/multi-agent-finance",
    bullets: [
      "Engineered multi-agent agentic AI with LangChain/LangGraph — automating transaction enrichment, spend categorization, and investment recommendations.",
      "Built RAG pipeline with Azure Vector Search & Cosmos DB — 93% retrieval accuracy, sub-100ms response times with hallucination guardrails.",
      "Integrated Plaid API + Alpaca for automated trade execution delivering 2.5% monthly ROI with 99.9% reliability.",
    ],
  },
  {
    name: "MindKeep — AI-Powered Second Brain",
    tech: "TypeScript, React, Plasmo, Gemini Nano, Transformers.js, Chrome MV3",
    period: "2025",
    link: "/projects/mindkeep",
    bullets: [
      "Built 100% local AI Chrome extension using Google Gemini Nano — semantic search, encrypted notes (AES-GCM), and in-page AI assistant with zero data leaving the browser.",
      "Winner entry for the Google Chrome Built-in AI Challenge 2025 — integrating Prompt, Summarizer, and Rewriter APIs with Transformers.js vector embeddings.",
    ],
  },
  {
    name: "SkyBMS AI — Battery Management System",
    tech: "Python, Machine Learning, Cloud Computing, IoT, REST APIs",
    period: "Jan 2024 — May 2024",
    link: "/projects/sky-bms",
    bullets: [
      "AI-powered BMS with real-time cloud analytics, dynamic dashboards, and chatbot integration for lithium-ion battery safety and lifespan optimization.",
    ],
  },
  {
    name: "WEB HUNTER — Web Reconnaissance",
    tech: "Python, Tkinter, DNS, SSL, Networking, Figma",
    period: "Mar 2023 — May 2023",
    link: "/projects/web-hunter",
    bullets: [
      "Python-based web recon tool with GUI for DNS enumeration and SSL certificate analysis — streamlined security assessment in a standalone executable.",
    ],
  },
  {
    name: "Study Table Organizing Robotic Arm",
    tech: "Python, TensorFlow, Computer Vision, Robotics, Servo Motors",
    period: "Aug 2023 — Dec 2023",
    link: "/projects/robotic-arm",
    bullets: [
      "Computer vision-powered robotic arm that autonomously detects, picks up, and organizes pens and pencils using TensorFlow object detection and precision servo control.",
    ],
  },
  {
    name: "Toolkit for WhatsApp",
    tech: "Android, Java, Firebase, Media APIs",
    period: "Apr 2020 — Jan 2021",
    link: "/projects/toolkit-for-whatsapp",
    bullets: [
      "All-in-one WhatsApp toolkit with 7+ powerful modules — Broadcaster, Sticker Maker, Photo Editor, Video Trimmer, Insta Downloader, DP Editor, and Memory Manager.",
    ],
  },
  {
    name: "ML-Based Smart Traffic Management System",
    tech: "C++, Node.js, TensorFlow, Computer Vision",
    period: "Jan 2019 — Mar 2019",
    link: "/projects/smart-traffic-management",
    bullets: [
      "Engineered city-scale computer vision platform across 50+ intersections — sub-second latency; co-authored Springer publication and filed patent.",
    ],
  },
  {
    name: "Smart Home — IoT Automation",
    tech: "Arduino, IoT, Android, Firebase, Voice Recognition, MQTT",
    period: "Jan 2018 — Mar 2018",
    link: "/projects/smart-home",
    bullets: [
      "Affordable IoT home automation with energy monitoring, voice control, multi-utility controllers, and Android companion app for real-time energy analytics and bill prediction.",
    ],
  },
];

const education = [
  {
    degree: "Master of Science",
    field: "Computer Science",
    school: "University of Colorado Denver",
    year: "2024",
    location: "Denver, CO",
    gpa: "GPA: 3.62/4.00",
    thesis: "",
    link: "/ms-diploma-sundeep-dayalan.pdf",
  },
  {
    degree: "Bachelor of Engineering",
    field: "Computer Science and Engineering",
    school: "Panimalar Engineering College",
    year: "2019",
    location: "Chennai, India",
    gpa: "GPA: 7.62/10.00",
    thesis: "",
  },
];

const certifications = [
  {
    name: "Microsoft Azure AI Engineer Associate (AI-102)",
    link: "https://learn.microsoft.com/en-us/users/sundeep-dayalan/credentials/FB97E950C7EC33E0?ref=https%3a%2f%2fwww.linkedin.com%2f",
  },
  {
    name: "Microsoft Azure Fundamentals (AZ-900)",
    link: "https://www.credly.com/badges/c893145b-cb64-4eb5-b9a9-8d37f633596f?source=linked_in_profile",
  },
];
const keywords =
  "Sundeep Dayalan, Software Development Engineer, SDE II, Amazon Web Services, AWS, RDS, Aurora, Distributed Systems, LLM Infrastructure, Telemetry, Python, Java, Spring Boot, React, TypeScript, Apache Kafka, Cloud Architecture, Agentic AI, Bellevue Washington";

const additionalLD = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Sundeep Dayalan",
    url: "https://www.sundeepdayalan.in",
    description:
      "Portfolio of Sundeep Dayalan — Software Development Engineer II at AWS, specializing in distributed systems, AI infrastructure, and real-time cloud platforms.",
    author: {
      "@type": "Person",
      name: "Sundeep Dayalan",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "Sundeep Dayalan — Software Development Engineer Portfolio",
    url: "https://www.sundeepdayalan.in",
    mainEntity: {
      "@type": "Person",
      name: "Sundeep Dayalan",
      jobTitle: "Software Development Engineer II",
      url: "https://www.sundeepdayalan.in",
      sameAs: [
        "https://www.linkedin.com/in/sundeep-dayalan",
        "https://github.com/sundeep-dayalan",
      ],
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/og/home.png"
  keywords={keywords}
  additionalLD={additionalLD}
>
  <Navbar />
  <main id="main-content">
    <!-- ==================== HERO ==================== -->
    <HeroTactile projectsCount={projects.length} />

    <!-- Kinetic band -->
    <Marquee
      items={[
        "DISTRIBUTED SYSTEMS",
        "AGENTIC AI",
        "REAL-TIME FINTECH",
        "5M+ USERS",
        "99.99% UPTIME",
      ]}
    />

    <!-- ==================== ABOUT ==================== -->
    <section class="section" id="about">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">PROFILE</span>
          <h2 class="section-title">
            <span class="section-title-inner">About</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <div class="about-grid">
          <div class="about-photo animate-on-scroll">
            <div data-plx="-0.06">
              <div class="about-frame about-img-wrap">
                <span class="x-corner x-tl" aria-hidden="true"></span>
                <span class="x-corner x-tr" aria-hidden="true"></span>
                <span class="x-corner x-bl" aria-hidden="true"></span>
                <span class="x-corner x-br" aria-hidden="true"></span>
                <Image
                  src={assetImg("profile.png")}
                  alt="Sundeep Dayalan — Senior Software Engineer"
                  width={640}
                  height={640}
                  loading="lazy"
                />
              </div>
              <div class="about-photo-strip">
                <span>SUNDEEP DAYALAN</span>
                <span>EST. 2019 — PRESENT</span>
              </div>
            </div>
          </div>

          <div class="about-copy animate-on-scroll" style="--delay: 120ms">
            <p class="about-lead">
              I build the systems that <span class="x-accent"
                >5 million people</span
              > rely on without ever noticing — which is exactly the point.
            </p>
            <p class="about-para">
              Software Development Engineer II at Amazon Web Services with 5+
              years architecting fault-tolerant, high-throughput distributed
              systems across cloud infrastructure, fintech, and agentic AI.
              Expert in Python, Java, and React/TypeScript — delivering
              production-grade LLM infrastructure and Kafka streaming pipelines
              at sub-200ms p99 latency with 99.99% uptime.
            </p>
            <p class="about-para">
              Published Springer researcher and pending patent holder in smart
              traffic systems. Proven force multiplier: I mentor engineering
              squads, author Architectural Decision Records, and build the
              high-ownership cultures that make good systems inevitable.
            </p>
            <p class="about-para about-para-dim">
              Off the clock — chasing new countries, communities, and cuisines.
              Always planning the next trip.
            </p>

            <div class="about-facts">
              <span class="about-fact">SPRINGER PUBLISHED</span>
              <span class="about-fact">PATENT PENDING</span>
              <span class="about-fact">MS COMPUTER SCIENCE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SKILLS ==================== -->
    <section class="section" id="skills">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">CAPABILITIES</span>
          <h2 class="section-title">
            <span class="section-title-inner">Stack</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <div class="skills-grid">
          {
            skills.map((skill, index) => (
              <article
                class="skill-cell animate-on-scroll"
                style={`--delay: ${index * 60}ms`}
              >
                <div class="skill-top">
                  <span class="skill-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="skill-rule" aria-hidden="true" />
                </div>
                <h3 class="skill-name">{skill.name}</h3>
                <p class="skill-desc">{skill.desc}</p>
                <div class="skill-tags">
                  {skill.tags.map((tag) => (
                    <span class="skill-tag">{tag}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==================== EXPERIENCE ==================== -->
    <section class="section" id="experience">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">TRACK RECORD</span>
          <h2 class="section-title">
            <span class="section-title-inner">Experience</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <div class="exp-list">
          {
            experience.map((exp, index) => (
              <div
                class="exp-row animate-on-scroll"
                style={`--delay: ${index * 80}ms`}
              >
                <div class="exp-side">
                  <span class="exp-period">{exp.period}</span>
                  <span class="exp-company">{exp.company}</span>
                  {exp.note && <span class="exp-location">{exp.note}</span>}
                  <span class="exp-location">{exp.location}</span>
                </div>
                <div class="exp-main">
                  <h3 class="exp-role">{exp.role}</h3>
                  <p class="exp-summary">{exp.summary}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ==================== PROJECTS ==================== -->
    <section class="section" id="projects">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">SELECTED WORK</span>
          <h2 class="section-title">
            <span class="section-title-inner">Projects</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <FeaturedProject
          index="01"
          name="Sentient Trader"
          tagline="Autonomous AI trading agent — ingests live market news, reasons across multiple signals, and executes paper trades with zero manual intervention."
          bullets={[
            "LangGraph orchestration with Groq-hosted LLaMA 3.1 and Alpaca trading APIs for end-to-end decisioning and execution.",
            "Production live demo with real-time streaming architecture and monitoring-focused workflow for safe iteration.",
          ]}
          tech={[
            "Python",
            "LangGraph",
            "Groq LLaMA 3.1",
            "Alpaca API",
            "Redis Streams",
            "Next.js",
          ]}
          period="2026"
          link="/projects/sentient-trader"
        />

        <div class="proj-index animate-on-scroll" id="proj-index">
          {
            projects.slice(1).map((proj, index) => (
              <a
                href={proj.link}
                class="proj-row"
                data-cursor="hover"
                data-preview-key={proj.link}
              >
                <span class="proj-num">
                  {String(index + 2).padStart(2, "0")}
                </span>
                <span class="proj-name">{proj.name}</span>
                <span class="proj-tech">{proj.tech}</span>
                <span class="proj-year">{proj.period}</span>
                <span class="proj-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </div>

        <!-- Floating cursor-following preview -->
        <div class="proj-preview" id="proj-preview" aria-hidden="true">
          {
            projects.slice(1).map((proj) =>
              projectPreviews[proj.link] ? (
                <div class="proj-preview-item" data-preview={proj.link}>
                  <Image
                    src={assetImg(projectPreviews[proj.link])}
                    alt=""
                    width={520}
                    loading="lazy"
                  />
                </div>
              ) : (
                <div
                  class="proj-preview-item proj-preview-fallback"
                  data-preview={proj.link}
                >
                  <span class="proj-preview-num" aria-hidden="true">
                    /
                  </span>
                  <span class="proj-preview-name">
                    {proj.name.split("—")[0].trim()}
                  </span>
                  <span class="proj-preview-sub">CASE STUDY</span>
                </div>
              ),
            )
          }
        </div>
      </div>
    </section>

    <!-- ==================== EDUCATION ==================== -->
    <section class="section" id="education">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">EDUCATION</span>
          <h2 class="section-title">
            <span class="section-title-inner">Education</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <div class="edu-grid">
          {
            education.map((edu, index) =>
              edu.link ? (
                <a
                  href={edu.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="edu-cell edu-cell-link animate-on-scroll"
                  style={`--delay: ${index * 100}ms`}
                  data-cursor="hover"
                >
                  <div class="edu-top">
                    <span class="edu-degree">{edu.degree}</span>
                    <span class="edu-year">{edu.year}</span>
                  </div>
                  <h3 class="edu-field">{edu.field}</h3>
                  <p class="edu-school">{edu.school}</p>
                  <div class="edu-meta">
                    <span>{edu.location}</span>
                    <span>{edu.gpa}</span>
                  </div>
                  <span class="edu-cta">VIEW DIPLOMA ↗</span>
                </a>
              ) : (
                <div
                  class="edu-cell animate-on-scroll"
                  style={`--delay: ${index * 100}ms`}
                >
                  <div class="edu-top">
                    <span class="edu-degree">{edu.degree}</span>
                    <span class="edu-year">{edu.year}</span>
                  </div>
                  <h3 class="edu-field">{edu.field}</h3>
                  <p class="edu-school">{edu.school}</p>
                  <div class="edu-meta">
                    <span>{edu.location}</span>
                    <span>{edu.gpa}</span>
                  </div>
                </div>
              ),
            )
          }
        </div>
      </div>
    </section>

    <!-- ==================== RESEARCH & PUBLICATIONS ==================== -->
    <section class="section" id="research">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">PUBLISHED WORK</span>
          <h2 class="section-title">
            <span class="section-title-inner">Research</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <div class="research-grid">
          <div class="research-cell animate-on-scroll">
            <span class="research-badge">PUBLICATION</span>
            <h3 class="research-title">
              Intelligent Traffic Management using ML and IoT
            </h3>
            <p class="research-desc">
              Peer-reviewed research on production ML systems at city scale —
              Springer Journal.
            </p>
            <a
              href="https://link.springer.com/chapter/10.1007/978-3-030-77637-4_2"
              target="_blank"
              rel="noopener noreferrer"
              class="research-link"
              data-cursor="hover">DOI: 10.1007/978-3-030-77637-4_2 ↗</a
            >
          </div>
          <div class="research-cell animate-on-scroll" style="--delay: 100ms">
            <span class="research-badge">PATENT PENDING</span>
            <h3 class="research-title">
              Live Digital Traffic Management System
            </h3>
            <p class="research-desc">
              Bay Detection & Dynamic Queuing Algorithms for real-time traffic
              optimization.
            </p>
          </div>
          <div class="research-cell animate-on-scroll" style="--delay: 200ms">
            <span class="research-badge">RESEARCH</span>
            <h3 class="research-title">
              Cybersecurity Challenges in EV Charging Infrastructure
            </h3>
            <p class="research-desc">
              Analysis of security vulnerabilities and mitigation strategies in
              EV charging networks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CERTIFICATIONS ==================== -->
    <section class="section" id="certifications">
      <div class="container">
        <div class="section-header animate-on-scroll">
          <span class="section-label">CREDENTIALS</span>
          <h2 class="section-title">
            <span class="section-title-inner">Certifications</span>
          </h2>
          <div class="section-divider"></div>
        </div>

        <div class="certs-list animate-on-scroll">
          {
            certifications.map((cert) =>
              cert.link ? (
                <a
                  href={cert.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-row"
                  data-cursor="hover"
                >
                  <span class="x-marker" aria-hidden="true">
                    /
                  </span>
                  <span class="cert-name">{cert.name}</span>
                  <span class="cert-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                <div class="cert-row cert-row-static">
                  <span class="x-marker" aria-hidden="true">
                    /
                  </span>
                  <span class="cert-name">{cert.name}</span>
                  <span class="cert-tag">IN PROGRESS</span>
                </div>
              ),
            )
          }
        </div>
      </div>
    </section>

    <!-- Kinetic band -->
    <Marquee
      items={[
        "OPEN TO COLLABORATE ON NOVEL IDEAS",
        "BELLEVUE WA",
        "SUNDEEP DAYALAN",
      ]}
      reverse={true}
      speed={0.5}
    />
  </main>

  <!-- ==================== CONTACT / FOOTER ==================== -->
  <footer class="footer" id="contact">
    <div class="container">
      <div class="footer-head animate-on-scroll">
        <span class="section-label">OPEN TO OPPORTUNITIES</span>
        <h2 class="footer-title" data-cursor="hover" data-plx="0.05">
          <span class="footer-title-line">LET'S BUILD</span>
          <span class="footer-title-line footer-title-outline"
            >SOMETHING<span class="x-accent">.</span></span
          >
        </h2>
      </div>

      <div class="footer-body animate-on-scroll" style="--delay: 120ms">
        <form
