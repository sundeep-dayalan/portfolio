const keywords = "Sundeep Dayalan, Senior Software Engineer, Distributed Systems, LLM Infrastructure, Fintech, Python, Django, Java, Spring Boot, React, TypeScript, Apache Kafka, Cloud Architecture, Agentic AI, Bellevue Washington";

const additionalLD = [
