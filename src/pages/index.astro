            </div>
            <div class="exp-main">
              <h3 class="exp-role">{exp.role}</h3>
              <p class="exp-summary">{exp.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== PROJECTS ==================== -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">SELECTED WORK</span>
        <h2 class="section-title">Projects</h2>
        <div class="section-divider"></div>
      </div>

      <FeaturedProject
        index="01"
        name="Sentient Trader"
        tagline="Autonomous AI trading agent — ingests live market news, reasons across multiple signals, and executes paper trades with zero manual intervention."
        bullets={[
          "LangGraph orchestration with Groq-hosted LLaMA 3.1 and Alpaca trading APIs for end-to-end decisioning and execution.",
          "Production live demo with real-time streaming architecture and monitoring-focused workflow for safe iteration.",
        ]}
        tech={["Python", "LangGraph", "Groq LLaMA 3.1", "Alpaca API", "Redis Streams", "Next.js"]}
        period="2026"
        link="/projects/sentient-trader"
      />

      <div class="proj-index animate-on-scroll">
        {projects.slice(1).map((proj, index) => (
          <a href={proj.link} class="proj-row" data-cursor="hover">
            <span class="proj-num">{String(index + 2).padStart(2, '0')}</span>
            <span class="proj-name">{proj.name}</span>
            <span class="proj-tech">{proj.tech}</span>
            <span class="proj-year">{proj.period}</span>
            <span class="proj-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== EDUCATION ==================== -->
  <section class="section" id="education">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">EDUCATION</span>
        <h2 class="section-title">Education</h2>
        <div class="section-divider"></div>
      </div>

      <div class="edu-grid">
        {education.map((edu, index) => (
          edu.link ? (
            <a href={edu.link} target="_blank" rel="noopener noreferrer" class="edu-cell edu-cell-link animate-on-scroll" style={`--delay: ${index * 100}ms`} data-cursor="hover">
              <div class="edu-top">
                <span class="edu-degree">{edu.degree}</span>
                <span class="edu-year">{edu.year}</span>
              </div>
              <h3 class="edu-field">{edu.field}</h3>
              <p class="edu-school">{edu.school}</p>
              <div class="edu-meta">
                <span>{edu.location}</span>
                <span>{edu.gpa}</span>
              </div>
              <span class="edu-cta">VIEW DIPLOMA ↗</span>
            </a>
          ) : (
            <div class="edu-cell animate-on-scroll" style={`--delay: ${index * 100}ms`}>
              <div class="edu-top">
                <span class="edu-degree">{edu.degree}</span>
                <span class="edu-year">{edu.year}</span>
              </div>
              <h3 class="edu-field">{edu.field}</h3>
              <p class="edu-school">{edu.school}</p>
              <div class="edu-meta">
                <span>{edu.location}</span>
                <span>{edu.gpa}</span>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== RESEARCH & PUBLICATIONS ==================== -->
  <section class="section" id="research">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">PUBLISHED WORK</span>
        <h2 class="section-title">Research</h2>
        <div class="section-divider"></div>
      </div>

      <div class="research-grid">
        <div class="research-cell animate-on-scroll">
          <span class="research-badge">PUBLICATION</span>
          <h3 class="research-title">Intelligent Traffic Management using ML and IoT</h3>
          <p class="research-desc">Peer-reviewed research on production ML systems at city scale — Springer Journal.</p>
          <a href="https://link.springer.com/chapter/10.1007/978-3-030-77637-4_2" target="_blank" rel="noopener noreferrer" class="research-link" data-cursor="hover">DOI: 10.1007/978-3-030-77637-4_2 ↗</a>
        </div>
        <div class="research-cell animate-on-scroll" style="--delay: 100ms">
          <span class="research-badge">PATENT PENDING</span>
          <h3 class="research-title">Live Digital Traffic Management System</h3>
          <p class="research-desc">Bay Detection & Dynamic Queuing Algorithms for real-time traffic optimization.</p>
        </div>
        <div class="research-cell animate-on-scroll" style="--delay: 200ms">
          <span class="research-badge">RESEARCH</span>
          <h3 class="research-title">Cybersecurity Challenges in EV Charging Infrastructure</h3>
          <p class="research-desc">Analysis of security vulnerabilities and mitigation strategies in EV charging networks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CERTIFICATIONS ==================== -->
  <section class="section" id="certifications">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">CREDENTIALS</span>
        <h2 class="section-title">Certifications</h2>
        <div class="section-divider"></div>
      </div>

      <div class="certs-list animate-on-scroll">
        {certifications.map((cert) => (
          cert.link ? (
            <a href={cert.link} target="_blank" rel="noopener noreferrer" class="cert-row" data-cursor="hover">
              <span class="x-marker" aria-hidden="true">/</span>
              <span class="cert-name">{cert.name}</span>
              <span class="cert-arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="cert-row cert-row-static">
              <span class="x-marker" aria-hidden="true">/</span>
              <span class="cert-name">{cert.name}</span>
              <span class="cert-tag">IN PROGRESS</span>
            </div>
          )
        ))}
