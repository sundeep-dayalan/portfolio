---

<BaseLayout
  title={title}
  description={description}
  ogImage="/og/home.png"
  keywords={keywords}
  additionalLD={additionalLD}
>
  <Navbar />
  <main id="main-content">

  <!-- ==================== HERO ==================== -->
  <HeroTactile projectsCount={projects.length} />

  <!-- ==================== ABOUT ==================== -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">PROFILE</span>
        <h2 class="section-title">About</h2>
        <div class="section-divider"></div>
      </div>

      <div class="about-grid">
        <div class="about-photo animate-on-scroll">
          <div class="about-frame about-img-wrap">
            <span class="x-corner x-tl" aria-hidden="true"></span>
            <span class="x-corner x-tr" aria-hidden="true"></span>
            <span class="x-corner x-bl" aria-hidden="true"></span>
            <span class="x-corner x-br" aria-hidden="true"></span>
            <Image
              src={assetImg('profile.png')}
              alt="Sundeep Dayalan — Senior Software Engineer"
              width={640}
              height={640}
              loading="lazy"
            />
          </div>
          <div class="about-photo-strip">
            <span>SUNDEEP DAYALAN</span>
            <span>EST. 2019 — PRESENT</span>
          </div>
        </div>

        <div class="about-copy animate-on-scroll" style="--delay: 120ms">
          <p class="about-lead">
            I build the systems that <span class="x-accent">5 million people</span> rely on
            without ever noticing — which is exactly the point.
          </p>
          <p class="about-para">
            Senior software engineer with 5+ years architecting fault-tolerant, high-throughput
            distributed systems across fintech, healthcare tech, and agentic AI. Expert in Python,
            Java, and React/TypeScript — delivering production-grade LLM infrastructure and Kafka
            streaming pipelines at sub-200ms p99 latency with 99.99% uptime.
          </p>
          <p class="about-para">
            Published Springer researcher and pending patent holder in smart traffic systems.
            Proven force multiplier: I mentor engineering squads, author Architectural Decision
            Records, and build the high-ownership cultures that make good systems inevitable.
          </p>
          <p class="about-para about-para-dim">
            Off the clock — chasing new countries, communities, and cuisines. Always planning
            the next trip.
          </p>

          <div class="about-facts">
            <span class="about-fact">SPRINGER PUBLISHED</span>
            <span class="about-fact">PATENT PENDING</span>
            <span class="about-fact">MS COMPUTER SCIENCE</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SKILLS ==================== -->
  <section class="section" id="skills">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">CAPABILITIES</span>
        <h2 class="section-title">Stack</h2>
        <div class="section-divider"></div>
      </div>

      <div class="skills-grid">
        {skills.map((skill, index) => (
          <article class="skill-cell animate-on-scroll" style={`--delay: ${index * 60}ms`}>
            <div class="skill-top">
              <span class="skill-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="skill-rule" aria-hidden="true"></span>
            </div>
            <h3 class="skill-name">{skill.name}</h3>
            <p class="skill-desc">{skill.desc}</p>
            <div class="skill-tags">
              {skill.tags.map(tag => (
                <span class="skill-tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== EXPERIENCE ==================== -->
  <section class="section" id="experience">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <span class="section-label">TRACK RECORD</span>
        <h2 class="section-title">Experience</h2>
        <div class="section-divider"></div>
      </div>

      <div class="exp-list">
        {experience.map((exp, index) => (
          <div class="exp-row animate-on-scroll" style={`--delay: ${index * 80}ms`}>
            <div class="exp-side">
              <span class="exp-period">{exp.period}</span>
              <span class="exp-company">{exp.company}</span>
              {exp.note && <span class="exp-location">{exp.note}</span>}
