    </div>
  </section>

  </main>

  <!-- ==================== CONTACT / FOOTER ==================== -->
  <footer class="footer" id="contact">
    <div class="container">
      <div class="footer-head animate-on-scroll">
        <span class="section-label">OPEN TO OPPORTUNITIES</span>
        <h2 class="footer-title" data-cursor="hover">
          <span class="footer-title-line">LET'S BUILD</span>
          <span class="footer-title-line footer-title-outline">SOMETHING<span class="x-accent">.</span></span>
        </h2>
      </div>

      <div class="footer-body animate-on-scroll" style="--delay: 120ms">
        <a href="mailto:sundeep.dayalan@gmail.com" class="footer-email ht-magnetic" data-cursor="hover">
          sundeep.dayalan@gmail.com
          <span class="footer-email-arrow" aria-hidden="true">→</span>
        </a>

        <div class="footer-links">
          <div class="footer-col">
            <span class="footer-col-label">LINKEDIN</span>
            <a href="https://www.linkedin.com/in/sundeep-dayalan" target="_blank" rel="noopener noreferrer" class="footer-link" data-cursor="hover">/in/sundeep-dayalan</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-label">GITHUB</span>
            <a href="https://github.com/sundeep-dayalan" target="_blank" rel="noopener noreferrer" class="footer-link" data-cursor="hover">/sundeep-dayalan</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-label">LOCATION</span>
            <span class="footer-link footer-link-static">Bellevue, WA — 47.6101°N</span>
          </div>
        </div>
      </div>

      <div class="footer-bar">
        <span>© {new Date().getFullYear()} SUNDEEP DAYALAN</span>
        <span class="footer-bar-mid">DESIGNED & ENGINEERED IN TRUE BLACK</span>
        <span>V6.0</span>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ============================================
     SHARED — scroll reveal + accents
     ============================================ */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s var(--ease-out-expo) var(--delay, 0ms),
      transform 0.9s var(--ease-out-expo) var(--delay, 0ms);
    will-change: opacity, transform;
  }

  .animate-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .x-accent { color: var(--color-primary); }

  .x-marker {
    color: var(--color-primary);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .x-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    z-index: 2;
    transition: border-color 0.35s var(--ease-out-expo);
  }
  .x-tl { top: -1px; left: -1px; border-top: 1px solid var(--color-text-dim); border-left: 1px solid var(--color-text-dim); }
  .x-tr { top: -1px; right: -1px; border-top: 1px solid var(--color-text-dim); border-right: 1px solid var(--color-text-dim); }
  .x-bl { bottom: -1px; left: -1px; border-bottom: 1px solid var(--color-text-dim); border-left: 1px solid var(--color-text-dim); }
  .x-br { bottom: -1px; right: -1px; border-bottom: 1px solid var(--color-text-dim); border-right: 1px solid var(--color-text-dim); }

  /* ============================================
     ABOUT
     ============================================ */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .about-frame {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    overflow: hidden;
  }

  .about-frame img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .about-frame:hover img {
