<script>
  /* ── Netlify contact form: AJAX submit with inline status ── */
  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    const status = document.getElementById("cf-status");
    const submit = document.getElementById(
      "cf-submit",
    ) as HTMLButtonElement | null;
    if (!form || !status || !submit) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      status.textContent = "TRANSMITTING…";
      status.className = "cf-status";

      try {
        const data = new FormData(form);
        const body = new URLSearchParams(
          data as unknown as Record<string, string>,
        ).toString();
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent =
          "✓ MESSAGE RECEIVED — I WILL GET BACK TO YOU SOON.";
        status.classList.add("ok");
        form.reset();
      } catch {
        status.textContent = "✕ TRANSMISSION FAILED — PLEASE TRY AGAIN.";
        status.classList.add("err");
      } finally {
        submit.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
  if (document.readyState === "interactive" || document.readyState === "complete") {
    initContactForm();
  } else {
    document.addEventListener("DOMContentLoaded", initContactForm);
  }
</script>

<script>
  /* Re-initialized on every client-side navigation (View Transitions) */
  let homeAC: AbortController | undefined;
  let homeRaf = 0;
  let homeLabelIO: IntersectionObserver | undefined;

  function initHome() {
    homeAC?.abort();
    cancelAnimationFrame(homeRaf);
    homeLabelIO?.disconnect();
    if (
      !document.getElementById("proj-index") &&
      !document.querySelector(".section-label")
    )
      return;
    homeAC = new AbortController();
    const { signal } = homeAC;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reducedMotion) return;

    /* ── Section labels: text decode / scramble on reveal ── */
    const GLYPHS = "█▓▒░<>/[]{}—+*";
    const labels = document.querySelectorAll<HTMLElement>(".section-label");
    const decode = (el: HTMLElement) => {
      const original = el.textContent || "";
      const D = 620;
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - t0) / D, 1);
        const settled = Math.floor(original.length * t);
        let out = original.slice(0, settled);
        for (let i = settled; i < original.length; i++) {
          out +=
            original[i] === " "
              ? " "
              : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        el.textContent = out;
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = original;
      };
      requestAnimationFrame(step);
    };

    const labelIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            decode(e.target as HTMLElement);
            labelIO.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    labels.forEach((l) => labelIO.observe(l));
    homeLabelIO = labelIO;

    /* ── Scroll parallax layers: [data-plx="speed"] ── */
    const plxEls = Array.from(
      document.querySelectorAll<HTMLElement>("[data-plx]"),
    ).map((el) => ({
      el,
      speed: parseFloat(el.dataset.plx || "0"),
    }));

    let plxTicking = false;
    const plxUpdate = () => {
      const vh = window.innerHeight;
      for (const { el, speed } of plxEls) {
        const r = el.getBoundingClientRect();
        if (r.bottom < -100 || r.top > vh + 100) continue;
        const mid = r.top + r.height / 2 - vh / 2;
        el.style.transform = `translateY(${(mid * speed).toFixed(2)}px)`;
      }
      plxTicking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!plxTicking) {
          plxTicking = true;
          requestAnimationFrame(plxUpdate);
        }
      },
      { passive: true, signal },
    );
    plxUpdate();

    /* ── Project index: cursor-following preview ── */
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    const preview = document.getElementById("proj-preview");
    const indexEl = document.getElementById("proj-index");
    if (!finePointer || !preview || !indexEl) return;

    const items = Array.from(
      preview.querySelectorAll<HTMLElement>("[data-preview]"),
    );
    let px = -200,
      py = -200; // lerped position
    let tx = -200,
      ty = -200; // target position
    let rot = 0;
    let visible = false;

    indexEl.addEventListener(
      "mousemove",
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
      },
      { passive: true, signal },
    );

    indexEl.querySelectorAll<HTMLElement>(".proj-row").forEach((row) => {
      row.addEventListener("mouseenter", () => {
        const key = row.dataset.previewKey;
        items.forEach((it) =>
          it.classList.toggle("is-active", it.dataset.preview === key),
        );
        if (!visible) {
          /* snap into place so it doesn't fly across the screen */
          px = tx;
          py = ty;
          visible = true;
          preview.classList.add("is-on");
        }
      });
    });

    indexEl.addEventListener("mouseleave", () => {
      visible = false;
      preview.classList.remove("is-on");
    });

    const lerp = (a: number, b: number, n: number) => a + (b - a) * n;

    function previewTick() {
      px = lerp(px, tx, 0.16);
      py = lerp(py, ty, 0.16);
      /* tilt with horizontal velocity */
      rot = lerp(rot, Math.max(-7, Math.min(7, (tx - px) * 0.06)), 0.2);
      preview!.style.transform =
        `translate(${(px + 28).toFixed(1)}px, ${(py - preview!.offsetHeight / 2).toFixed(1)}px) ` +
        `scale(${visible ? 1 : 0.88}) rotate(${rot.toFixed(2)}deg)`;
      homeRaf = requestAnimationFrame(previewTick);
    }
    homeRaf = requestAnimationFrame(previewTick);
  }

  document.addEventListener("astro:page-load", initHome);
  if (document.readyState === "interactive" || document.readyState === "complete") {
    initHome();
  } else {
    document.addEventListener("DOMContentLoaded", initHome);
  }
</script>
