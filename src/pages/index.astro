---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroTactile from '../components/HeroTactile.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const rawImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*', { eager: true });
function assetImg(filename: string): ImageMetadata {
  const clean = filename.startsWith('/') ? filename.slice(1) : filename;
  const mod = rawImages[`/src/assets/images/${clean}`];
  if (!mod) throw new Error(`Image not found: ${clean}`);
  return mod.default;
}

const title = "Sundeep Dayalan | Senior Software Engineer — Distributed Systems · LLM Infrastructure · Real-Time Fintech";
const description = "Portfolio of Sundeep Dayalan — Senior Software Engineer with 5+ years architecting fault-tolerant distributed systems, LLM orchestration, and real-time fintech platforms. Python/Django, Java/Spring Boot, React/TypeScript. Published researcher & patent holder.";

const skills = [
  { name: "Backend", desc: "Python, Django, DRF, Java, Spring Boot, Node.js, C++, FastAPI, GraphQL, REST APIs, gRPC", tags: ["Python", "Django", "Java", "Spring Boot", "FastAPI", "gRPC"] },
  { name: "Frontend", desc: "React, TypeScript, JavaScript, MUI, Component Libraries, Dynamic Data Visualizations, Responsive UI", tags: ["React", "TypeScript", "MUI", "JavaScript"] },
  { name: "Data Engineering", desc: "PySpark, Databricks, Delta Lake, Apache Kafka, Spark, Airflow, GCP Dataflow, ETL/ELT, 1B+ event pipelines", tags: ["Kafka", "PySpark", "Databricks", "Airflow"] },
  { name: "AI/ML & LLM", desc: "LLM Orchestration, LangChain, LangGraph, Multi-Agent Systems, RAG, Agentic Workflows, Vector Search, TensorFlow", tags: ["LangChain", "RAG", "LangGraph", "TensorFlow"] },
  { name: "Cloud & Infra", desc: "AWS (CDK, S3, Lambda), GCP (BigQuery, Dataflow), Azure, Terraform, Kubernetes, Docker, Jenkins, CI/CD, GitOps", tags: ["AWS", "GCP", "Azure", "Terraform", "K8s"] },
  { name: "Databases", desc: "PostgreSQL, BigQuery, T-SQL, Redis (sharding, replication), Azure Cosmos DB, SQL Query Optimization", tags: ["PostgreSQL", "Redis", "BigQuery", "Cosmos DB"] },
  { name: "Observability & SRE", desc: "OpenTelemetry, Distributed Tracing, Prometheus, Grafana, SLO/SLA Design, Dynatrace, Splunk, p99 Tuning", tags: ["OpenTelemetry", "Prometheus", "Grafana", "Splunk"] },
  { name: "Security & Compliance", desc: "RBAC, PII Handling, Zero-Trust, SOC2/GDPR, Azure AD, OAuth 2.0, JWT, ACH/NACHA, WCAG 2.1 Accessibility", tags: ["RBAC", "OAuth 2.0", "Zero-Trust", "WCAG"] },
];

const experience = [
  {
    company: "Amazon Web Services",
    role: "SDE II",
    period: "Aug 2026 — Present",
    location: "Redmond, WA, USA",
    summary: "Building the telemetry infrastructure behind Amazon Aurora and RDS — systems that collect, ingest, and route database telemetry across millions of instances, feeding a fleet-wide data lake and AI-driven engines that detect performance anomalies, diagnose root causes, and deliver tuning recommendations to customers at massive scale."
  },
  {
    company: "Accenture",
    note: "Contract",
    role: "Software Engineer",
    period: "May 2024 — Jul 2026",
    location: "USA",
    summary: "Architected a production-grade banking platform end to end — Python/Java Spring Boot APIs, React/TypeScript frontend, and Kafka streaming pipelines serving 5M+ users at sub-200ms p99. Delivered 99.99% uptime with sharded Redis clusters, OpenTelemetry tracing across 15+ microservices, and Terraform/Jenkins GitOps automation, while driving zero-trust RBAC and org-wide ADRs across 4 squads."
  },
  {
    company: "Accenture",
    role: "Associate Software Engineer",
    period: "Jun 2019 — Aug 2022",
    location: "Chennai, India",
    summary: "Designed fault-tolerant REST & GraphQL APIs sustaining 5M+ TPS at sub-100ms SLAs and built PySpark ETL/ELT pipelines on Databricks with Delta Lake — cutting large-scale processing time 45% through Python and BigQuery optimization while mentoring junior engineers on SRE practices."
