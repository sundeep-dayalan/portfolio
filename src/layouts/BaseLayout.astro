---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  publishedTime?: string;
  keywords?: string;
  noindex?: boolean;
  additionalLD?: object[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-image.png',
  type = 'website',
  publishedTime,
  keywords,
  noindex = false,
  additionalLD = [],
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sundeep Dayalan",
  "url": "https://www.sundeepdayalan.in",
  "image": "https://www.sundeepdayalan.in/profile.png",
  "jobTitle": "Software Development Engineer II",
  "description": "Software Development Engineer II at Amazon Web Services with 5+ years architecting fault-tolerant distributed systems, LLM orchestration pipelines, and real-time cloud platforms.",
  "worksFor": {
    "@type": "Organization",
    "name": "Amazon Web Services"
  },
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "University of Colorado Denver",
      "url": "https://www.ucdenver.edu"
    },
    {
      "@type": "CollegeOrUniversity",
      "name": "Panimalar Engineering College"
    }
  ],
  "knowsAbout": [
    "Distributed Systems",
    "LLM Infrastructure",
    "Real-Time Fintech",
    "Python",
    "Django",
    "Java",
    "Spring Boot",
    "React",
    "TypeScript",
    "Apache Kafka",
    "Cloud Architecture",
    "Agentic AI"
  ],
  "sameAs": [
    "https://www.linkedin.com/in/sundeep-dayalan",
    "https://github.com/sundeep-dayalan",
    "https://www.sundeepdayalan.in"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={ogImage}
      type={type}
      publishedTime={publishedTime}
      keywords={keywords}
      noindex={noindex}
    />

    <!-- Person schema — present on every page -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Per-page structured data (SoftwareApplication, BreadcrumbList, WebSite, etc.) -->
    {additionalLD.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- apps.sundeepdayalan.in root → hub redirect (Netlify host-conditions unreliable) -->
    <script is:inline>
      if (location.hostname === 'apps.sundeepdayalan.in' && location.pathname === '/') {
        location.replace('/apps');
      }
    </script>

    <!-- Client-side page transitions -->
    <ClientRouter />
  </head>
  <body>
    <!-- Tactile Minimalism theme -->

    <slot />

    <!-- Custom cursor (fine pointers only; activated by script below) -->
    <div id="x-cursor" aria-hidden="true"></div>

    <!-- Scroll progress line -->
    <div id="x-progress" aria-hidden="true"></div>

    <!-- ── LIGHTBOX ── -->
    <div id="lb-overlay" aria-modal="true" role="dialog" aria-label="Image viewer">
      <div id="lb-inner">
        <div class="lb-corner tl"></div>
        <div class="lb-corner tr"></div>
        <div class="lb-corner bl"></div>
        <div class="lb-corner br"></div>
        <div class="lb-hud">
          <span id="lb-label" class="lb-label">IMAGE</span>
          <button id="lb-close" aria-label="Close">✕ CLOSE</button>
        </div>
        <div id="lb-img-wrap">
          <img id="lb-img" src="" alt="" />
        </div>
        <div id="lb-caption"></div>
      </div>
    </div>

    <!-- Smooth scroll + intersection observer for animations -->
    <script>
      /* Re-initialized on every client-side navigation (View Transitions) */
      let baseAC: AbortController | undefined;
      let baseObserver: IntersectionObserver | undefined;
      let baseRaf = 0;

      function initBase() {
      baseAC?.abort();
      baseAC = new AbortController();
      const { signal } = baseAC;
      baseObserver?.disconnect();
      cancelAnimationFrame(baseRaf);

      // Intersection Observer for fade-in animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      baseObserver = observer;
      document.querySelectorAll('.animate-on-scroll').forEach(el => {
        observer.observe(el);
      });

      // ── Lightbox ──
      const overlay  = document.getElementById('lb-overlay')!;
      const lbImg    = document.getElementById('lb-img') as HTMLImageElement;
      const lbCap    = document.getElementById('lb-caption')!;
      const lbLabel  = document.getElementById('lb-label')!;
      const lbClose  = document.getElementById('lb-close')!;

      const SELECTORS = [
        '.gallery-img-wrap img',
        '.module-img-wrap img',
        '.bay-img-wrap img',
        '.diagram-frame img',
        '.award-check-img img',
        '.award-photo-wrap img',
        '.jury-photo-wrap img',
        '.team-photo-wrap img',
        '.about-img-wrap img',
        '.phone-frame img',
        '.proto-photos img',
        '.realworld-photos img',
      ].join(', ');

      function openLightbox(img: HTMLImageElement) {
        lbImg.src = img.src;
        lbImg.alt = img.alt;
        lbCap.textContent = img.alt;
        // derive a label from the closest frame-label or alt
        const frameLabel = img.closest('[class]')?.parentElement?.querySelector('.frame-label');
        lbLabel.textContent = frameLabel?.textContent || 'IMAGE';
        overlay.classList.add('lb-open');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        overlay.classList.remove('lb-open');
        document.body.style.overflow = '';
        setTimeout(() => { lbImg.src = ''; }, 300);
      }

      document.querySelectorAll<HTMLImageElement>(SELECTORS).forEach(img => {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', (e) => {
          e.stopPropagation();
          openLightbox(img);
        });
      });

      lbClose.addEventListener('click', closeLightbox);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      }, { signal });

      // ── Scroll progress line ──
      (() => {
        const bar = document.getElementById('x-progress');
        if (!bar) return;
        let ticking = false;
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? window.scrollY / max : 0;
          bar.style.transform = `scaleX(${p.toFixed(4)})`;
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }, { passive: true, signal });
        update();
      })();

      // ── Custom cursor + magnetic elements (site-wide, fine pointers only) ──
      (() => {
        const finePointer = window.matchMedia('(pointer: fine)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!finePointer || reducedMotion) return;

        const cursor = document.getElementById('x-cursor');
        let mx = -100, my = -100;
        let cx = -100, cy = -100;

        document.documentElement.style.cursor = 'none';
        document.body.style.cursor = 'none';
        cursor?.classList.add('is-active');

        window.addEventListener('mousemove', (e) => {
          mx = e.clientX;
          my = e.clientY;
        }, { passive: true, signal });

        const HOVER_TARGETS = 'a, button, [data-cursor="hover"], h1, .section-title';
        document.addEventListener('mouseover', (e) => {
          const t = e.target;
          if (cursor && t instanceof Element && t.closest(HOVER_TARGETS)) cursor.classList.add('is-hover');
        }, { signal });
        document.addEventListener('mouseout', (e) => {
          const t = e.target;
          if (cursor && t instanceof Element && t.closest(HOVER_TARGETS)) cursor.classList.remove('is-hover');
        }, { signal });

        // Magnetic pull for tagged elements
        const magnets = Array.from(document.querySelectorAll('.ht-magnetic, [data-magnetic]'));
        const magnetState = magnets.map((el) => ({ el: el as HTMLElement, x: 0, y: 0, tx: 0, ty: 0 }));

        window.addEventListener('mousemove', (e) => {
          for (const m of magnetState) {
            const r = m.el.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            const dist = Math.hypot(dx, dy);
            const radius = Math.max(r.width, r.height) * 1.4;
            if (dist < radius) {
              const pull = 1 - dist / radius;
              m.tx = dx * 0.35 * pull;
              m.ty = dy * 0.35 * pull;
            } else {
              m.tx = 0;
              m.ty = 0;
            }
          }
        }, { passive: true, signal });

        const lerp = (a: number, b: number, n: number) => a + (b - a) * n;

        function xTick() {
          cx = lerp(cx, mx, 0.22);
          cy = lerp(cy, my, 0.22);
          if (cursor) {
            const half = cursor.offsetWidth / 2;
            cursor.style.transform = `translate(${cx - half}px, ${cy - half}px)`;
          }
          for (const m of magnetState) {
            m.x = lerp(m.x, m.tx, 0.18);
            m.y = lerp(m.y, m.ty, 0.18);
            m.el.style.transform = `translate(${m.x.toFixed(2)}px, ${m.y.toFixed(2)}px)`;
          }
          baseRaf = requestAnimationFrame(xTick);
        }
        baseRaf = requestAnimationFrame(xTick);
      })();
      }

      document.addEventListener('astro:page-load', initBase);
      if (document.readyState === 'interactive' || document.readyState === 'complete') {
        initBase();
      } else {
        document.addEventListener('DOMContentLoaded', initBase);
      }
    </script>
  </body>
</html>
